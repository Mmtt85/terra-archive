{"cv":[{"lang":"한국어","names":["김채하"]},{"lang":"일본어","names":["타도코로 아즈사"]},{"lang":"중국어","names":["Menglu Yang"]},{"lang":"영어","names":["Jessica Preddy"]},{"lang":"이탈리아어","names":["Ilaria Silvestri"]}],"lines":[{"t":"어시스턴트 임명","x":"다음 임무는 박사의 신변 경호인가.","u":null,"p":"HOME_PLACE"},{"t":"대화 1","x":"과묵하다고? 그건 내가…… 웬만한 일에는 감흥이 없어서 그래.","u":null,"p":"HOME_SHOW"},{"t":"대화 2","x":"우리 업무는 삶과 죽음을 나르는 것이다.","u":null,"p":"HOME_SHOW"},{"t":"대화 3","x":"운전 중에는 보통 소라가 부른 곡들을 듣고 있다.","u":null,"p":"HOME_SHOW"},{"t":"1차 정예화 후 대화","x":"담배냐고? 아니, 이건 초콜릿이다. 정기적인 열량 섭취는 필수니까. 그렇지…… 커피라도 한잔 어때?","u":{"type":"AWAKE","param":"1"},"p":"HOME_SHOW"},{"t":"2차 정예화 후 대화","x":"언제부터 펭귄 로지스틱스에서 일했냐고? 음…… 언제부터였더라……","u":{"type":"AWAKE","param":"2"},"p":"HOME_SHOW"},{"t":"신뢰도 상승 후 대화 1","x":"붉은 늑대는 조심하는 편이 좋아. 나쁜 녀석은 아니지만…… 우리와는 달라.","u":{"type":"FAVOR","param":"40"},"p":"HOME_SHOW"},{"t":"신뢰도 상승 후 대화 2","x":"아무리 도망쳐도, 언젠간 과거에 따라잡히게 되지.","u":{"type":"FAVOR","param":"100"},"p":"HOME_SHOW"},{"t":"신뢰도 상승 후 대화 3","x":"자유로운 삶, 시끌벅적한 동료들…… 여러모로 귀찮지만…… 지금은 그것도 나쁘지 않은 거 같아.","u":{"type":"FAVOR","param":"200"},"p":"HOME_SHOW"},{"t":"방치","x":"지금 휴식 시간인가?","u":null,"p":"HOME_WAIT"},{"t":"오퍼레이터 입사","x":"이름은 텍사스라고 한다. 차량 운전, 물자 수송, 그리고 요인 경호를 맡고 있다. 임무에 관한 지시는 되도록 간결하게 부탁한다.","u":null,"p":"GACHA"},{"t":"작전기록 학습","x":"고마워.","u":null,"p":"LEVEL_UP"},{"t":"1차 정예화 (승진)","x":"보수라면, 이걸로 충분해.","u":{"type":"AWAKE","param":"1"},"p":"EVOLVE_ONE"},{"t":"2차 정예화 (승진)","x":"박사의 신뢰에, 감사를 표하지.","u":{"type":"AWAKE","param":"2"},"p":"EVOLVE_TWO"},{"t":"팀 배치","x":"뭘 하면 되지?","u":null,"p":"SQUAD"},{"t":"팀장 임명","x":"남들한테 지시 내리는 건 잘 못하는데.","u":null,"p":"SQUAD_FIRST"},{"t":"작전 출발","x":"출발한다.","u":null,"p":"BATTLE_START"},{"t":"작전 개시","x":"엑시아, 엄호해줘.","u":null,"p":"BATTLE_FACE_ENEMY"},{"t":"오퍼레이터 선택 1","x":"명령을 내려줘.","u":null,"p":"BATTLE_SELECT"},{"t":"오퍼레이터 선택 2","x":"알겠다.","u":null,"p":"BATTLE_SELECT"},{"t":"배치 1","x":"발도.","u":null,"p":"BATTLE_PLACE"},{"t":"배치 2","x":"시작하지.","u":null,"p":"BATTLE_PLACE"},{"t":"작전 중 1","x":"흥.","u":null,"p":"BATTLE_SKILL_1"},{"t":"작전 중 2","x":"누구도 날 묶어두진 못해.","u":null,"p":"BATTLE_SKILL_2"},{"t":"작전 중 3","x":"철저하게 베어 주마.","u":null,"p":"BATTLE_SKILL_3"},{"t":"작전 중 4","x":"닥쳐라.","u":null,"p":"BATTLE_SKILL_4"},{"t":"고난이도 작전 종료","x":"훗…… 문제 없다.","u":null,"p":"FOUR_STAR"},{"t":"3★ 작전 종료","x":"약하군.","u":null,"p":"THREE_STAR"},{"t":"비 3★ 작전 종료","x":"몇 명 놓쳤다.","u":null,"p":"TWO_STAR"},{"t":"작전 실패","x":"이번 임무를 너무 쉽게 본 모양이군……","u":null,"p":"LOSE"},{"t":"시설에 배치","x":"필요한 물자가 있나? 도와주도록 하지.","u":null,"p":"BUILDING_PLACE"},{"t":"터치","x":"윽……","u":null,"p":"BUILDING_TOUCHING"},{"t":"신뢰도 터치","x":"무슨 일이지, 박사?","u":null,"p":"BUILDING_FAVOR_BUBBLE"},{"t":"타이틀","x":"명일방주.","u":null,"p":"LOADING_PANEL"},{"t":"새해","x":"새해 복 많이 받아. 난 이 물건을 엑시아에게 가져다주려던 참이었어. 자기 실적이 꼴찌가 아니라는 것을 축하하는 파티를 오늘 밤에 연다고 하더군. 크루아상도 들여온 물건들을 옮기는 것 같던데, 지금쯤이면 노점을 다 차렸으려나…… 그나저나 소라의 신곡 들어봤어? 난 좋던데.","u":null,"p":"NEW_YEAR"},{"t":"인사","x":"어, 안녕?","u":null,"p":"GREETING"},{"t":"생일","x":"이 상자에는 내가 용문에서 가져온 보스의 애장품 LP판들이 들어있다. 보스가 뭐라고 생각할지는 신경 쓰지 말고 받아, 박사. 그럼 생일 축하한다.","u":null,"p":"BIRTHDAY"},{"t":"애니버서리","x":"로도스 아일랜드의 기념일은 좋네. 이건 내가 가져온 술이 든 초콜릿이야. 럼주가 들어 있는 아몬드 맛이지. 조금 쓰긴 한데 맛이 괜찮으니 한번 먹어봐.","u":null,"p":"ANNIVERSARY"}]}