{
  "manifest_version": 3,
  "name": "테라 브리지 (실험)",
  "version": "0.3.0",
  "description": "게임 창(에뮬레이터·PC 클라이언트)을 테라 아카이브에 연결해 화면을 자동 인식시킵니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "desktopCapture"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://terra-archive.net/*",
        "https://www.terra-archive.net/*",
        "https://terra-archive.pages.dev/*",
        "https://*.terra-archive.pages.dev/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "테라 브리지 — 눌러서 연결 페이지 열기"
  }
}
