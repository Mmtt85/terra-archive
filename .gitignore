# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
.wrangler/
/outputs/
/work/
tsconfig.tsbuildinfo
Arknights_OperBox_Export.json

# Claude Code 로컬 설정 (머신별 권한·경로·dev 서버 기동)
.claude/settings.json
.claude/settings.local.json
.claude/launch.json
.gamedata/

# 스토리 요약 번역 작업 중간 산출물 (최종본은 app/data/story-summaries.{en,ja}.json)
scripts/story-i18n/
scripts/story-cn/

# CI 임시 리포트/로그
# 디렉터리째(`.ci/`) 무시하면 git 이 안으로 내려가지 않아 아래 예외가 먹지 않는다.
.ci/*
# 점검 감시 기준선만 예외로 추적한다 (2026-09-16) — 러너 캐시는 조용히 비워져 헛발동을
# 부르고, 레포에 두면 "언제 뭐가 움직였나"가 기록으로 남는다.
!.ci/resversion.json
.cache/
.gamedata-ci/
.r2-sync-key
.supabase-admin-key
.admin-rotate.generated.sql
.upload-admin-key

# 스킨 이미지(반신 초상 + 전체 일러, ~296MB) — git에 넣지 않는다 (2026-07-28 사용자 확정).
# 서빙은 R2(files.terra-archive.net)가 하고, 로컬 사본은 scripts/build-skins.py로 언제든
# 다시 받을 수 있다(멱등 — 있는 파일은 건너뜀). .git이 이미 9.6GB라 더 불리지 않는다.
# ⚠ 메타(public/skins/*.json)와 프로필(public/profiles/*.json)은 작아서 커밋한다.
/public/skin/

# 로그라이크 노드 종류 아이콘 — git에 넣지 않는다 (2026-07-29 사용자 지시 "깃에 올리지말고
# R2에 올려줘"). 서빙은 R2(files.terra-archive.net/assets/rogue/node/…), 재생성은
# python3 scripts/build-rogue.py --node-icons (멱등).
/public/rogue/node/

# 직전 배포 청크 캐시 (scripts/keep-assets.mjs) — 배포마다 갱신되는 로컬 산출물
.deploy-assets/

# 기록 번역용 CN 원문 골격 — build-records.py가 매번 다시 떨어뜨린다 (번역본만 커밋)
scripts/records-cn/_src/

# 위수 협의·록라 인식 회귀 픽스처 — 게임 스크린샷/녹화라 크고(45MB) 개인 화면이 찍힌다.
# ⚠ 2026-09-18에 `fixtures/` 를 통째로 비웠다 (사용자 판단: 다시 찍을 때면 게임 화면이
#   어차피 달라져 있다). 아래 규칙은 **다시 찍었을 때를 위한 것**이라 남겨 둔다 —
#   원본 이미지는 로컬에만 두고 작은 기대값 JSON만 커밋한다.
/fixtures/lens/screenshots/
/fixtures/scanner/screenshots/
# tesseract 언어 모델(kor·chi_sim 등, 각 2~20MB) — 검증 스크립트가 리포 루트에 받아 두는
# 캐시지 소스가 아니다. 지워도 다음 실행에 다시 받는다.
/*.traineddata
# 위수 협의 PRTS 녹화 프레임(2026-09-07, 수백 MB) — 로컬 전용. 기대값은 scripts/verify-autochess.ts 에 코드로 둔다.
/fixtures/lens/ac-frames/

# 스크린샷 저장 경로가 비었을 때 만들어지는 쓰레기 폴더 (2026-09-05에 한 번 커밋됐다)
/undefined/

# 위수 협의 인식 실험 스크립트 (측정용 — 정본은 scripts/verify-ac/*)
/scripts/ac-lab/
