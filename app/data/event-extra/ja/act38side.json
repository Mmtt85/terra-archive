t"]]],["PV-EX-4をクリア",[["item","act38side_token_ticket","匿名招待状",60,"act38side_token_ticket"]]],["PV-EX-5をクリア",[["item","act38side_token_ticket","匿名招待状",60,"act38side_token_ticket"]]],["PV-EX-6をクリア",[["item","act38side_token_ticket","匿名招待状",60,"act38side_token_ticket"]]],["PV-EX-7をクリア",[["item","act38side_token_ticket","匿名招待状",80,"act38side_token_ticket"]]],["PV-EX-8をクリア",[["item","act38side_token_ticket","匿名招待状",80,"act38side_token_ticket"]]],["PV-EX-8の強襲作戦をクリア",[["furn","furni_terratimes_Siracusa_01","パネル「秩序とは」",1]]],["★3評価でPV-S-1をクリア",[["item","act38side_token_ticket","匿名招待状",40,"act38side_token_ticket"]]],["★3評価でPV-S-2をクリア",[["item","act38side_token_ticket","匿名招待状",40,"act38side_token_ticket"]]],["★3評価でPV-S-3をクリア",[["item","act38side_token_ticket","匿名招待状",60,"act38side_token_ticket"]]],["★3評価でPV-S-4をクリア",[["item","act38side_token_ticket","匿名招待状",60,"act38side_token_ticket"]]],["★3評価でPV-S-5をクリア",[["item","act38side_token_ticket","匿名招待状",80,"act38side_token_ticket"]]],["イベントステージを15回クリア（チュートリアルを除く）",[["item","act38side_token_ticket","匿名招待状",80,"act38side_token_ticket"]]],["イベントステージを45回クリア（チュートリアルを除く）",[["item","act38side_token_ticket","匿名招待状",100,"act38side_token_ticket"]]],["イベントステージを85回クリア（チュートリアルを除く）",[["item","act38side_token_ticket","匿名招待状",120,"act38side_token_ticket"]]]],"furn":{"list":[["furni_tailorShop_shelf_01","裁縫道具置き",2],["furni_tailorShop_mirror_01","大型試着台",2],["furni_tailorShop_wardrobe_01","生地用ショーケース",2],["furni_tailorShop_stool_01","裁縫スツール",2],["furni_tailorShop_pottedplant_01","「アリバイ証明」",2],["furni_tailorShop_coffeetable_01","接客用テーブル",2],["furni_tailorShop_wallpaper_01","サルトリアの壁",2],["furni_tailorShop_floor_01","サルトリアの床",2],["furni_terratimes_Siracusa_01","パネル「秩序とは」",2]],"theme":["シラクーザのサルトリア","フィグリーノの説明をもとに再現した、伝統的なシラクーザスタイルの衣服を仕立てるサルトリア。ファミリーの顔役であれ、ごく普通なシラクーザ人であれ、誰にとっても体裁を保つための装いというのは重要なものだ。"]},"medals":{"list":[["medal_activity_38side_01","「悪意の狂宴」","T3","","貴殿はヌオバ・ウォルシーニでいつまでも続くカルネヴァーレを過ごした。\n罪人の仮面を砕き、悪意の爪牙を取り除く。",0],["medal_activity_38side_02","「暴君の災難」","T1","「幕開く者たち」開催期間中に、クラウンスレイヤーを雇用する。","貴殿は王冠を狩る者と再び相まみえた。\n「殉難者の苦しみを呑みこみ、棄てられた者の怒りを噛み砕く。」",0],["medal_activity_38side_03","夜市満喫勲章","T1","「幕開く者たち」開催期間中に、「狂宴の夜市」で匿名招待状を2400個消費。","貴殿は招待状を片手に夜市で豪快に買い物をし、カルネヴァーレで一番の人気者となった。\n貴殿が狂宴の主とあまりにも親しいことは誰の目にも明らかだ。彼女の誘いには注意すべきだろう。",0],["medal_activity_38side_04","終劇感謝勲章","T1","★3で「カドリール」の全てのステージをクリア（チュートリアルを除く）。","貴殿はシラクーザの新都市で最初の公演を楽しんだ。\n幕が開ければ、素晴らしいショーはすぐ目の前だ。",0],["medal_activity_38side_05","狂宴マスター勲章","T2","「行進日程表」を全てクリアし、報酬を獲得。","貴殿はヌオバ・ウォルシーニにおいて、カルネヴァーレを隅々まで体験した。楽しんでいただけたのなら喜ばしい限りだ。\n昔から続く祝い事に新たな伝統が生まれ、新都市は古き時代に別れを告げた。",0],["medal_activity_38side_06","「狂宴開花」","T1","<極寒割薬>の花火を打ち上げた上で、PV-SP-1を★3でクリア。","カルネヴァーレのクライマックス、貴殿は花火の導火線を灯した。\n「この花火はキミが選んだの？悪くないセンスだね。ボクと一緒に次の街にもデカいのを打ち上げてみない？」",0],["medal_activity_38side_07","「風船キラー」","T1","イベントステージでバルーンを累計150個破壊。","貴殿はカルネヴァーレの風船を目の敵にした、風船が貴殿の目から逃れられるはずがない。\n飾りつけの作業員たちは、カルネヴァーレ期間中に故意に風船を割る「謎の殺し屋」を追っている。貴殿に心当たりはないだろうか？",0],["medal_activity_38side_08","パレード引率勲章","T2","「煌めく遊覧車」の全てのステージの強襲作戦をクリア。","貴殿はパレード隊の引率として、街中を練り歩いた。\n真新しいフロート車がヌオバ・ウォルシーニ中を巡りながら、シラクーザが過去のように戻ることは決してないと約束している。",0],["medal_activity_38side_09","悪狼狂舞勲章","T2","「荒寥の舞」の全てのステージの強襲作戦をクリア。","貴殿は狂宴の主とともに荒寥の舞を踊り終えた。\n「さあ一緒に踊ろう、繁栄の幕が閉じない内に。さあ一緒に踊ろう、悪華繚乱たるシラクーザよ。」",0],["medal_activity_38side_10","「特任花火師」","T2","「花火実行委員会」の依頼を2回クリア。","貴殿がカルネヴァーレのためにデザインした花火は多くの好評を得た。\nこの盛り上がりは貴殿のおかげでもある。特別に貴殿を花火実行委員会のアートディレクターに任命しよう。ただし、報酬は出ない。",0]],"set":["幕開く者たち勲章シリーズ","ヌオバ・ウォルシーニにおいてカルネヴァーレの幕が開かれる過程を記録した勲章シリーズ。\n狂宴は一発の銃声と共に盛大に始まり、群狼は荒寥の中で舞い踊り別れを告げる。幕開けの時は来た。"]},"story":{"id":"act38side","eps":[["PV-ST-1","幕間"],["PV-1","戦闘前"],["PV-1","戦闘後"],["PV-2","戦闘前"],["PV-2","戦闘後"],["PV-3","戦闘前"],["PV-3","戦闘後"],["PV-4","戦闘前"],["PV-4","戦闘後"],["PV-ST-2","幕間"],["PV-5","戦闘前"],["PV-5","戦闘後"],["PV-6","戦闘前"],["PV-6","戦闘後"],["PV-7","戦闘前"],["PV-7","戦闘後"],["PV-8","戦闘前"],["PV-8","戦闘後"],["PV-ST-3","幕間"],["PV-9","戦闘前"],["PV-9","戦闘後"],["PV-10","戦闘前"],["PV-10","戦闘後"],["PV-ST-4","幕間"]],"sum":1,"scene":1}}